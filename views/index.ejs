<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.site_name || 'Trust Formation' %> — <%= settings.site_tagline || 'Global Business Formation' %></title>
  <link rel="icon" href="<%= settings.logo_light || '/trust-white-logo.png' %>">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    :root {
      --primary: <%= settings.primary_color || '#0D1B2A' %>;
      --accent: <%= settings.accent_color || '#E8963E' %>;
      --bg-dark: <%= settings.bg_color || '#0A0F1C' %>;
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <%- include('partials/hero') %>
  <%- include('partials/logos') %>
  <%- include('partials/services') %>
  <%- include('partials/whyus') %>
  <%- include('partials/process') %>
  <%- include('partials/pricing') %>
  <%- include('partials/testimonials') %>
  <%- include('partials/faq') %>
  <%- include('partials/cta') %>
  <%- include('partials/contact') %>
  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
