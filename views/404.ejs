<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>404 - Page Not Found</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', system-ui, sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #0A0F1C; color: #E2E8F0; }
    .container { text-align: center; }
    h1 { font-size: 6rem; font-weight: 900; color: #E8963E; opacity: 0; animation: bounceIn 0.6s ease 0.1s forwards; }
    p { color: #94A3B8; margin: 1rem 0 2rem; font-size: 1.1rem; opacity: 0; animation: fadeInUp 0.5s ease 0.3s forwards; }
    a { color: #E8963E; text-decoration: none; font-weight: 600; opacity: 0; animation: fadeInUp 0.5s ease 0.5s forwards; display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.8rem 2rem; border: 2px solid #E8963E; border-radius: 50px; transition: all 0.3s ease; }
    a:hover { background: #E8963E; color: #0A0F1C; }
    @keyframes bounceIn { 0% { opacity: 0; transform: scale(0.3); } 50% { opacity: 1; transform: scale(1.05); } 70% { transform: scale(0.9); } 100% { opacity: 1; transform: scale(1); } }
    @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: 0.01ms !important; } h1, p, a { opacity: 1 !important; } }
  </style>
</head>
<body>
  <div class="container">
    <h1>404</h1>
    <p>The page you're looking for doesn't exist.</p>
    <a href="/">&larr; Back to Home</a>
  </div>
</body>
</html>
