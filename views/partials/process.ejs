<section class="process-section section">
  <div class="container">
    <div style="text-align:center;" data-animate="fade-up">
      <span class="section-label">How It Works</span>
      <h2 class="section-title">Our <span class="highlight">Process</span></h2>
      <p class="section-subtitle" style="margin:0 auto;">From consultation to formation, we make it simple.</p>
    </div>

    <div class="process-grid" data-animate="fade-up" data-delay="2">
      <div class="process-step" data-animate="fade-up" data-delay="3">
        <div class="process-number">1</div>
        <h3><%= settings.process_step1_title || 'Consultation' %></h3>
        <p><%= settings.process_step1_desc || 'Share your business goals and we\'ll recommend the best formation strategy.' %></p>
      </div>
      <div class="process-step" data-animate="fade-up" data-delay="4">
        <div class="process-number">2</div>
        <h3><%= settings.process_step2_title || 'Documentation' %></h3>
        <p><%= settings.process_step2_desc || 'We prepare and file all required documents with the relevant authorities.' %></p>
      </div>
      <div class="process-step" data-animate="fade-up" data-delay="5">
        <div class="process-number">3</div>
        <h3><%= settings.process_step3_title || 'Formation' %></h3>
        <p><%= settings.process_step3_desc || 'Your company is officially registered and ready to operate.' %></p>
      </div>
      <div class="process-step" data-animate="fade-up" data-delay="6">
        <div class="process-number">4</div>
        <h3><%= settings.process_step4_title || 'Ongoing Support' %></h3>
        <p><%= settings.process_step4_desc || 'Bank accounts, compliance, tax filing — we support you long-term.' %></p>
      </div>
    </div>
  </div>
</section>
